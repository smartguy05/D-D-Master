# --- Required for voice, text-mode DM, images and the OpenAI brain ---
OPENAI_API_KEY=

# --- Brain (background planner / rules / content) ---
# openai | anthropic
BRAIN_PROVIDER=openai
BRAIN_MODEL_OPENAI=gpt-5
ANTHROPIC_API_KEY=
BRAIN_MODEL_ANTHROPIC=claude-opus-5
# Brain request timeout in ms (one retry) and optional OpenAI reasoning effort (minimal|low|medium|high)
BRAIN_TIMEOUT_MS=900000
# consult_brain (the DM waits on it live): past this the DM is told to improvise and carry on
CONSULT_TIMEOUT_MS=30000
# BRAIN_REASONING_EFFORT=low

# --- AI players (a seat played by an AI; toggle "AI" on a player in Party) ---
# Provider defaults to BRAIN_PROVIDER; use a fast model, they answer mid-conversation.
# AI_PLAYER_PROVIDER=openai
AI_PLAYER_MODEL_OPENAI=gpt-5-mini
AI_PLAYER_MODEL_ANTHROPIC=claude-haiku-5-5
# Per decision timeout (ms) and the least time between two unprompted lines (ms)
AI_PLAYER_TIMEOUT_MS=20000
AI_PLAYER_SPONTANEOUS_COOLDOWN_MS=90000

# --- Realtime voice DM ---
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=cedar
# Transcription model used for the host transcript log
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Noise-turn gate: wait for a voice turn's transcript and skip coughs/fillers ("uh", "bless you").
# off/false/0/no/disabled/none = answer on commit (lower latency). The timeout (ms, 0 allowed)
# answers anyway if no transcript arrives.
TURN_GATE=on
TURN_GATE_TIMEOUT_MS=1200
# How soon a pause ends a player's turn (semantic VAD): low | medium | high | auto. low (default)
# waits longest, so slow or thoughtful talkers aren't answered mid-sentence; high answers fastest.
REALTIME_VAD_EAGERNESS=low
# A Realtime call ends at 60 min. After VOICE_HANDOVER_AFTER_MS (50 min) the server silently renews
# it at a quiet moment; at VOICE_HANDOVER_DEADLINE_MS (57 min) it swaps once the DM isn't speaking.
VOICE_HANDOVER_AFTER_MS=3000000
VOICE_HANDOVER_DEADLINE_MS=3420000
# The DM voices every quoted NPC line in that NPC's own voice on /table (speak_as_npc).
# On by default (needs OPENAI_API_KEY); set NPC_TTS=0 to turn it off and let the DM speak NPC lines itself.
NPC_TTS=1
NPC_TTS_MODEL=gpt-4o-mini-tts
# A speech request that takes longer fails (one retry); the DM or AI player line goes on as text.
NPC_TTS_TIMEOUT_MS=15000

# --- Images ---
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium
# One image request, its one retry included (ms); past it the job fails instead of hanging
IMAGE_TIMEOUT_MS=300000
# Paint the next unpainted location's map in the background when the party arrives somewhere (off: 0)
PREPAINT_MAPS=1

# --- Speaker identification (voiceprints) ---
SPEAKER_MODEL=models/wespeaker_en_voxceleb_resnet34.onnx
SPEAKER_THRESHOLD=0.45

# --- Server ---
PORT=8787
# Second listener over HTTPS for a laptop running /host and /table against this machine (browsers
# only allow the mic on https or localhost). 0 = off. Without HTTPS_CERT/HTTPS_KEY a self-signed
# certificate is made in DATA_DIR/certs (accept the browser warning once).
HTTPS_PORT=8443
# Optional: your own certificate and key (e.g. from mkcert), both paths.
HTTPS_CERT=
HTTPS_KEY=
# Optional: the address phones should open (QR codes and player links), e.g. http://192.168.1.20:8787.
# Empty = the laptop's LAN IP on PORT.
PUBLIC_URL=
DATA_DIR=campaigns
