# --- Required for voice, text-mode DM, images and the OpenAI brain ---
OPENAI_API_KEY=

# --- Brain (background planner / rules / content) ---
# openai | anthropic
BRAIN_PROVIDER=openai
BRAIN_MODEL_OPENAI=gpt-5
ANTHROPIC_API_KEY=
BRAIN_MODEL_ANTHROPIC=claude-opus-5
# Brain request timeout in ms (one retry) and optional OpenAI reasoning effort (minimal|low|medium|high)
BRAIN_TIMEOUT_MS=900000
# BRAIN_REASONING_EFFORT=low

# --- Realtime voice DM ---
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=cedar
# Transcription model used for the host transcript log
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Noise-turn gate: wait for a voice turn's transcript and skip coughs/fillers ("uh", "bless you").
# off/false/0/no/disabled/none = answer on commit (lower latency). The timeout (ms, 0 allowed)
# answers anyway if no transcript arrives.
TURN_GATE=on
TURN_GATE_TIMEOUT_MS=1200
# The DM voices every quoted NPC line in that NPC's own voice on /table (speak_as_npc).
# On by default (needs OPENAI_API_KEY); set NPC_TTS=0 to turn it off and let the DM speak NPC lines itself.
NPC_TTS=1
NPC_TTS_MODEL=gpt-4o-mini-tts

# --- Images ---
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium
# Paint the next unpainted location's map in the background when the party arrives somewhere (off: 0)
PREPAINT_MAPS=1

# --- Speaker identification (voiceprints) ---
SPEAKER_MODEL=models/wespeaker_en_voxceleb_resnet34.onnx
SPEAKER_THRESHOLD=0.45

# --- Server ---
PORT=8787
# Optional: the address phones should open (QR codes and player links), e.g. http://192.168.1.20:8787.
# Empty = the laptop's LAN IP on PORT.
PUBLIC_URL=
DATA_DIR=campaigns
